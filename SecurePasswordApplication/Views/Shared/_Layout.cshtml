<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kestrel</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg navbar-light">
            <div class="container">

                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    Kestrel - Password Manager
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>


                <div class="collapse navbar-collapse" id="navbarNav">

                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Dashboard
                            </a>
                        </li>


                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="PasswordEntries"
                               asp-action="Index">
                                Passwords
                            </a>
                        </li>


                        <li class="nav-item">
                            <a class="nav-link" asp-controller="ActivityLogs" asp-action="Index">
                                Logs
                            </a>
                        </li>

                    </ul>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle"
                           href="#"
                           role="button"
                           data-bs-toggle="dropdown">
                            Account
                        </a>

                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item"
                                   asp-area="Identity"
                                   asp-page="/Account/Manage/Index">
                                    Profile
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                   asp-area="Identity"
                                   asp-page="/Account/Manage/ChangePassword">
                                    Change Password
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                   asp-area="Identity"
                                   asp-page="/Account/Manage/TwoFactorAuthentication">
                                    Two-Factor Authentication
                                </a>
                            </li>
                        </ul>
                    </li> 
                    <ul class="navbar-nav">

                        <partial name="_LoginPartial" />

                    </ul>

                </div>

            </div>
        </nav>
    </header>


    <div class="container mt-4">

        <main role="main">
            @RenderBody()
        </main>

    </div>


    <footer class="border-top footer text-muted mt-5">

        <div class="container">
            © @DateTime.Now.Year - Kestrel | Made by Lorcan Delong
        </div>

    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>