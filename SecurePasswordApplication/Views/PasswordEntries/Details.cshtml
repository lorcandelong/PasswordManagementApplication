@model SecurePasswordApplication.Models.PasswordEntry

@{
    ViewData["Title"] = "Password Details";

    var daysRemaining = Model.ExpirationDate.HasValue
        ? (Model.ExpirationDate.Value.Date - DateTime.Today).Days
        : (int?)null;
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-danger text-white">
            <h3 class="mb-0">Password Details</h3>
        </div>

        <div class="card-body">

            <div class="row mb-3">
                <div class="col-sm-3 fw-bold">
                    Website
                </div>

                <div class="col-sm-9">
                    @Model.Website
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-sm-3 fw-bold">
                    Username
                </div>

                <div class="col-sm-9">
                    @Model.Username
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-sm-3 fw-bold">
                    Password
                </div>

                <div class="col-sm-9">

                    <span id="passwordDisplay">
                        ********
                    </span>

                    <button class="btn btn-sm btn-outline-secondary ms-2"
                            id="revealButton"
                            onclick="togglePassword(@Model.Id)">
                        Reveal
                    </button>

                </div>
            </div>

            <div class="row mb-3">
                <div class="col-sm-3 fw-bold">
                    Notes
                </div>

                <div class="col-sm-9">
                    @(string.IsNullOrWhiteSpace(Model.Notes)
                        ? "None"
                        : Model.Notes)
                </div>
            </div>

            <hr />

            <div class="row mb-3">
                <div class="col-sm-3 fw-bold">
                    Created
                </div>

                <div class="col-sm-9">
                    @Model.CreatedDate.ToString("MMMM dd, yyyy")
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-sm-3 fw-bold">
                    Expires
                </div>

                <div class="col-sm-9">

                    @if (!Model.ExpirationDate.HasValue)
                    {
                        <span class="badge bg-secondary">
                            No Expiration
                        </span>
                    }
                    else if (daysRemaining < 0)
                    {
                        <span class="badge bg-danger">
                            Expired
                        </span>

                        <span class="ms-2">
                            @Model.ExpirationDate.Value.ToString("MMMM dd, yyyy")
                        </span>
                    }
                    else if (daysRemaining <= 30)
                    {
                        <span class="badge bg-warning text-dark">
                            Expires Soon
                        </span>

                        <span class="ms-2">
                            @Model.ExpirationDate.Value.ToString("MMMM dd, yyyy")
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success">
                            Healthy
                        </span>

                        <span class="ms-2">
                            @Model.ExpirationDate.Value.ToString("MMMM dd, yyyy")
                        </span>
                    }

                </div>
            </div>

        </div>

        <div class="card-footer">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-danger">
                Edit
            </a>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back
            </a>

        </div>

    </div>

</div>

<script>

    async function togglePassword(id) {

        const span = document.getElementById("passwordDisplay");
        const button = document.getElementById("revealButton");

        if(button.textContent === "Hide"){

            span.textContent = "********";
            button.textContent = "Reveal";
            return;
        }

        const response =
            await fetch('/PasswordEntries/RevealPassword/' + id);

        if(response.ok){

            const password = await response.text();

            span.textContent = password;
            button.textContent = "Hide";
        }
    }

</script>